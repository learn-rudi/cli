{
  "openapi": "3.1.0",
  "info": {
    "title": "RUDI Local Daemon API",
    "version": "1.0.0",
    "description": "Local authenticated capability API. Native agent providers own normal execution and authoritative transcripts; Agent Host stores bounded launch pointers and reconnect events."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "8100",
          "description": "Dynamic daemon port written to ~/.rudi/daemon.port"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Daemon",
      "description": "Lifecycle and readiness"
    },
    {
      "name": "Capabilities",
      "description": "Local package, secret, runtime, and environment capabilities"
    },
    {
      "name": "Agent Host",
      "description": "Thin provider-native launch control and reconnect pointers"
    }
  ],
